<?xml version="1.0" encoding="utf-8"?>
<!-- rig-bt-helper: pairs and unpairs Bluetooth devices through the API, under the shell's permissions. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ohu.rig.bthelper"
    android:versionCode="1"
    android:versionName="1">

    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application android:label="rig-bt-helper" android:hasCode="true" />

    <instrumentation
        android:name="ohu.rig.bthelper.BtInstrumentation"
        android:targetPackage="ohu.rig.bthelper"
        android:label="rig-bt-helper" />
</manifest>
